# Database (PostgreSQL via pgAdmin)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/factupro?schema=public"

# Clerk (https://dashboard.clerk.com → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Admin plateforme (emails séparés par des virgules)
# Compte dédié : accès UNIQUEMENT à /admin
PLATFORM_ADMIN_EMAILS=ariskpandja@gmail.com
NEXT_PUBLIC_PLATFORM_ADMIN_EMAILS=ariskpandja@gmail.com

# Email (https://resend.com) — requis pour envoyer les factures
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="FactuPro <onboarding@resend.dev>"
